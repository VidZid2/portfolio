{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@ncdai": "https://chanhdai.com/r/{name}.json",
    "@soundcn": "https://soundcn.xyz/r/{name}.json",
    "@beui": "https://beui.dev/r/{name}.json",
    "@iconiq": "https://iconiqui.com/r/{name}.json",
    "@ai-elements": "https://ai-sdk.dev/elements/api/registry/{name}.json",
    "@magicui": "https://magicui.design/r/{name}",
    "@extend": "https://ui.extend.ai/r/{name}.json",
    "@skiper-ui": "https://skiper-ui.com/registry/{name}.json",
    "@bklit": "https://ui.bklit.com/r/{name}.json"
  }
}
